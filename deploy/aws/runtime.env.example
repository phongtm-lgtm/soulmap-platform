# This file documents runtime names only. The real file is generated on EC2 from
# CloudFormation outputs and AWS-managed secrets.
SOULMAP_IMAGE=000000000000.dkr.ecr.ap-southeast-1.amazonaws.com/soulmap-api:GIT_SHA
PUBLIC_HOST=api.203-0-113-10.sslip.io
ROUTER_PUBLIC_HOST=router.203-0-113-10.sslip.io
ROUTER_PUBLIC_URL=https://router.203-0-113-10.sslip.io
ACME_EMAIL=admin@example.com

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8090
SOULMAP_FRONTEND_ORIGIN=https://your-production-frontend.example
SOULMAP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SOULMAP_SESSION_DURATION_DAYS=14
SOULMAP_SESSION_COOKIE_SECURE=true
SOULMAP_SESSION_COOKIE_SAME_SITE=None

SOULMAP_DATABASE_URL=jdbc:postgresql://example.rds.amazonaws.com:5432/soulmap?sslmode=require
SOULMAP_DATABASE_USERNAME=soulmap_admin
SOULMAP_DATABASE_PASSWORD=FROM_RDS_SECRETS_MANAGER
SOULMAP_DB_POOL_MAX_SIZE=5
SOULMAP_DB_POOL_MIN_IDLE=1

SOULMAP_AI_PROVIDER=9router
SOULMAP_AI_BASE_URL=http://9router:20128/v1
SOULMAP_AI_API_KEY=SET_AFTER_9ROUTER_INITIALIZATION
SOULMAP_AI_MODEL=SET_AFTER_9ROUTER_INITIALIZATION
SOULMAP_AI_TIMEOUT_SECONDS=300
SOULMAP_AI_STRUCTURED_OUTPUT_MODE=json_object

JWT_SECRET=FROM_SSM
INITIAL_PASSWORD=FROM_SSM
API_KEY_SECRET=FROM_SSM
MACHINE_ID_SALT=FROM_SSM
