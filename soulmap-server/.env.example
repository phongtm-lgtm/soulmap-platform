# Spring profile
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8090

# Database
SOULMAP_DATABASE_NAME=soulmap
SOULMAP_DATABASE_PORT=5432
SOULMAP_DATABASE_URL=jdbc:postgresql://localhost:5432/soulmap
SOULMAP_DATABASE_USERNAME=postgres
SOULMAP_DATABASE_PASSWORD=123456

# Database connection pool
SOULMAP_DB_POOL_MAX_SIZE=10
SOULMAP_DB_POOL_MIN_IDLE=2
SOULMAP_DB_CONNECTION_TIMEOUT_MS=30000
SOULMAP_DB_IDLE_TIMEOUT_MS=600000
SOULMAP_DB_MAX_LIFETIME_MS=1800000

# Logging
SOULMAP_LOG_LEVEL=INFO
SOULMAP_APP_LOG_LEVEL=DEBUG

# OpenAPI / Swagger
SOULMAP_OPENAPI_ENABLED=true
SOULMAP_SWAGGER_UI_ENABLED=true
